# Must match the code's actual read (client/src/api/client.ts reads
# VITE_API_BASE, not VITE_API_URL) and must include the /api path — without
# this file, the client falls back to a hardcoded http://localhost:4000/api,
# which only coincidentally matched the server when server/.env wasn't being
# loaded at all (see server/src/server.ts history). Keep this in sync with
# PORT in server/.env.
VITE_API_BASE="http://localhost:3000/api"
