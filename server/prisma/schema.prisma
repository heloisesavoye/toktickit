generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
}

// Lab 2: temporary Development Requester used for testing only (BR-03).
// In Lab 3 this becomes the authenticated user; the shape is kept stable on purpose (BR-20).
model Requester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([isActive])
}

model Category {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  isActive Boolean  @default(true)
  tickets  Ticket[]
}

model RelatedSystem {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  isActive Boolean  @default(true)
  tickets  Ticket[]
}

model Ticket {
  id                Int           @id @default(autoincrement())
  ticketNumber      String        @unique
  requesterId       Int
  requester         Requester     @relation(fields: [requesterId], references: [id])
  categoryId        Int
  category          Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority Priority
  itPriority        Priority?
  currentStatus     TicketStatus  @default(NEW)
  ticketDate        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attachments       Attachment[]

  @@index([requesterId, createdAt])
}

model Attachment {
  id             Int       @id @default(autoincrement())
  ticketId       Int
  ticket         Ticket    @relation(fields: [ticketId], references: [id])
  fileName       String
  storedFileName String
  mimeType       String
  sizeBytes      Int
  uploadedAt     DateTime  @default(now())
  isRemoved      Boolean   @default(false)
  removedAt      DateTime?
  removedBy      Int?
  removalReason  String?

  @@index([ticketId])
}

// Backs BR-01: unique, sequential, backend-generated Ticket Number per year.
model TicketSequence {
  year  Int @id
  value Int @default(0)
}
