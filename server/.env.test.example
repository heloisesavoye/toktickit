
# Dedicated database for `npm test`. The Lab 3 test suite truncates every
# table between tests (see tests/lab-03/testUtils.ts resetDatabase()) — never
# point this at the same database used by `npm run dev` / `npm run seed`, or
# every test run wipes your seeded dev accounts.
#
# One-time setup (adjust to your local Postgres role/password):
#   psql -U postgres -h localhost
#   CREATE DATABASE toktickit_test OWNER toktickit;
#
# Then: cp .env.test.example .env.test
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_test?schema=public"
PORT=3000
